generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RawItem {
  id               String   @id @default(cuid())
  source           String
  sourceType       String
  sourceItemId     String?
  observedAt       DateTime
  observedAtBucket DateTime
  payload          Json
  metadata         Json?
  dedupeKey        String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  signals Signal[]

  @@index([source, sourceType, observedAtBucket])
  @@map("raw_items")
}

model Signal {
  id         String   @id @default(cuid())
  rawItemId  String
  source     String
  platform   String?
  signalType String
  title      String
  summary    String?
  observedAt DateTime
  rawRefs    Json
  metrics    Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rawItem       RawItem        @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]
  youtubeVideoAnalyses YoutubeVideoAnalysis[]
  opportunityMiningRuns OpportunityMiningSignalRun[]

  @@index([source, signalType, observedAt])
  @@map("signals")
}

model YoutubeVideoAnalysis {
  id                 String   @id @default(cuid())
  signalId           String
  videoId            String
  status             String
  transcriptStatus   String?
  transcriptProvider String?
  transcriptLanguage String?
  transcriptText     String?
  transcriptSegments Json?
  result             Json?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId])
  @@index([status, createdAt])
  @@index([videoId])
  @@map("youtube_video_analyses")
}

model EvidenceItem {
  id           String   @id @default(cuid())
  signalId     String?
  sourceTool   String?
  sourceType   String
  sourceItemId String?
  claim        String
  text         String?
  url          String?
  author       String?
  publishedAt  DateTime?
  observedAt   DateTime
  metrics      Json?
  confidence   String
  rawRef       String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([signalId])
  @@index([sourceType, observedAt])
  @@map("evidence_items")
}

model CollectionRun {
  id            String    @id @default(cuid())
  jobId         String
  pluginId      String
  capabilityId  String
  status        String
  startedAt     DateTime
  finishedAt    DateTime?
  rawItemCount  Int       @default(0)
  errorMessage  String?
  input         Json?
  outputSummary Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([jobId, startedAt])
  @@index([pluginId, capabilityId, startedAt])
  @@map("collection_runs")

  xTrendSnapshots XTrendSnapshot[]
  kolRadarSnapshots KolRadarSnapshot[]
}

model XTrendSnapshot {
  id              String   @id @default(cuid())
  collectionRunId String
  region          String
  observedAt      DateTime
  itemCount       Int
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collectionRun CollectionRun         @relation(fields: [collectionRunId], references: [id], onDelete: Cascade)
  items         XTrendSnapshotItem[]
  diffs         XTrendSnapshotDiff[]  @relation("CurrentXTrendSnapshotDiff")
  nextDiffs     XTrendSnapshotDiff[]  @relation("PreviousXTrendSnapshotDiff")

  @@unique([collectionRunId, region])
  @@index([region, observedAt])
  @@map("x_trend_snapshots")
}

model XTrendSnapshotItem {
  id         String   @id @default(cuid())
  snapshotId String
  name       String
  query      String
  rank       Int
  url        String?
  heat       String?
  category   String?
  raw        Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  snapshot XTrendSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, query])
  @@index([query, rank])
  @@map("x_trend_snapshot_items")
}

model XTrendSnapshotDiff {
  id                 String   @id @default(cuid())
  snapshotId         String
  previousSnapshotId String?
  region             String
  name               String
  query              String
  previousRank       Int?
  currentRank        Int?
  rankDelta          Int?
  diffType           String
  observedAt         DateTime
  createdAt          DateTime @default(now())

  snapshot         XTrendSnapshot  @relation("CurrentXTrendSnapshotDiff", fields: [snapshotId], references: [id], onDelete: Cascade)
  previousSnapshot XTrendSnapshot? @relation("PreviousXTrendSnapshotDiff", fields: [previousSnapshotId], references: [id], onDelete: SetNull)

  @@index([region, observedAt])
  @@index([query, observedAt])
  @@map("x_trend_snapshot_diffs")
}

model KolRadarSnapshot {
  id              String   @id @default(cuid())
  collectionRunId String   @unique
  observedAt      DateTime
  itemCount       Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collectionRun CollectionRun @relation(fields: [collectionRunId], references: [id], onDelete: Cascade)
  items         KolRadarSnapshotItem[]

  @@index([observedAt])
  @@map("kol_radar_snapshots")
}

model KolRadarSnapshotItem {
  id           String   @id @default(cuid())
  snapshotId   String
  rank         Int
  handle       String
  authorName   String?
  title        String
  summary      String
  observedAt   DateTime
  publishedAt  String?
  postType     String?
  url          String?
  metrics      Json?
  signalId     String?
  rawItemId    String?
  sourceItemId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  snapshot KolRadarSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, handle])
  @@index([handle, rank])
  @@map("kol_radar_snapshot_items")
}

model ProjectConfig {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_configs")
}

model AgentRun {
  id          String    @id @default(cuid())
  agentType   String
  status      String
  goal        Json
  result      Json?
  errorMessage String?
  startedAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps     AgentRunStep[]
  toolCalls AgentToolCall[]
  copilotActions CopilotProposedAction[]

  @@index([agentType, startedAt])
  @@map("agent_runs")
}

model AgentRunStep {
  id        String   @id @default(cuid())
  runId     String
  stepIndex Int
  stepType  String
  input     Json?
  output    Json?
  reason    String?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepIndex])
  @@map("agent_run_steps")
}

model AgentToolCall {
  id           String    @id @default(cuid())
  runId        String?
  toolName     String
  status       String
  input        Json
  output       Json?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([runId, startedAt])
  @@index([toolName, startedAt])
  @@map("agent_tool_calls")
}

model CopilotSession {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  client    String
  title     String?
  status    String   @default("active")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CopilotMessage[]
  actions  CopilotProposedAction[]

  @@index([tenantId, userId, updatedAt])
  @@map("copilot_sessions")
}

model CopilotMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  session CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("copilot_messages")
}

model CopilotProposedAction {
  id                   String    @id @default(cuid())
  agentRunId           String
  sessionId            String
  tenantId             String
  userId               String
  tool                 String
  summary              String
  arguments            Json
  status               String
  requiresConfirmation Boolean   @default(true)
  confirmedBy          String?
  confirmedAt          DateTime?
  executedAt           DateTime?
  result               Json?
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  agentRun AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  session  CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  audits   CopilotAuditLog[]

  @@index([sessionId, status, createdAt])
  @@index([tool, createdAt])
  @@map("copilot_proposed_actions")
}

model CopilotAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  actionId  String?
  tool      String
  operation String
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())

  action CopilotProposedAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, createdAt])
  @@index([tool, createdAt])
  @@map("copilot_audit_logs")
}

model OpportunityRulePack {
  id          String   @id @default(cuid())
  version     Int
  status      String
  basePath    String
  manifest    Json
  description String?
  generatedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  miningRuns OpportunityMiningSignalRun[]

  @@unique([version])
  @@index([status, version])
  @@map("opportunity_rule_packs")
}

model OpportunityMiningSignalRun {
  id             String   @id @default(cuid())
  signalId       String
  agentRunId     String?
  rulePackId     String?
  status         String
  decision       String?
  targetType     String?
  targetId       String?
  idempotencyKey String   @unique
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  signal   Signal               @relation(fields: [signalId], references: [id], onDelete: Cascade)
  rulePack OpportunityRulePack?  @relation(fields: [rulePackId], references: [id], onDelete: SetNull)

  @@index([signalId, createdAt])
  @@index([status, createdAt])
  @@map("opportunity_mining_signal_runs")
}

model FutureEvent {
  id          String    @id @default(cuid())
  title       String
  eventType   String
  scheduledAt DateTime?
  startAt     DateTime?
  endAt       DateTime?
  domains     Json
  summary     String?
  whyItMatters String?
  status      String
  createdFrom String
  confidence  String
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  monitoringPlans FutureEventMonitoringPlan[]

  @@index([eventType, status])
  @@index([scheduledAt])
  @@map("future_events")
}

model FutureEventCandidate {
  id                            String    @id @default(cuid())
  title                         String
  eventType                     String
  scheduledAt                   DateTime?
  timeRange                     Json?
  domains                       Json
  summary                       String
  whyItMatters                  String
  recommendedMonitoringStartAt  DateTime?
  recommendedMonitoringEndAt    DateTime?
  suggestedKeywords             Json
  suggestedAccounts             Json
  suggestedPlatforms            Json
  evidenceRefs                  Json
  confidence                    String
  status                        String
  missingData                   Json?
  riskNotes                     Json?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([eventType, status])
  @@index([scheduledAt])
  @@map("future_event_candidates")
}

model FutureEventSourcePlan {
  id               String   @id @default(cuid())
  version          Int
  status           String
  strategyMarkdown String
  sources          Json
  missingSources   Json?
  refreshPolicy    Json
  reason           String
  generatedBy      String
  agentRunId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([version])
  @@index([status, version])
  @@map("future_event_source_plans")
}

model FutureEventMonitoringPlan {
  id                    String   @id @default(cuid())
  futureEventId          String
  monitoringStartAt      DateTime
  monitoringEndAt        DateTime
  phases                 Json
  triggerRules           Json
  expectedContentAngles  Json
  evidenceRefs           Json
  confidence             String
  missingData            Json?
  riskNotes              Json?
  status                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)
  runs        FutureEventMonitoringRun[]

  @@index([futureEventId, status])
  @@index([monitoringStartAt, monitoringEndAt])
  @@map("future_event_monitoring_plans")
}

model FutureEventMonitoringRun {
  id            String    @id @default(cuid())
  futureEventId String
  planId        String
  phase         String
  status        String
  startedAt     DateTime
  finishedAt    DateTime?
  rawItemCount  Int       @default(0)
  signalCount   Int       @default(0)
  errorMessage  String?
  input         Json?
  outputSummary Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan FutureEventMonitoringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([futureEventId, startedAt])
  @@index([planId, phase, startedAt])
  @@map("future_event_monitoring_runs")
}

model Opportunity {
  id             String   @id @default(cuid())
  title          String
  type           String
  summary        String
  whyNow         String
  whyItMatters   String
  productAngles  Json
  contentWindow  String?
  evidenceRefs   Json
  missingData    Json
  riskNotes      Json
  confidence     String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, status])
  @@index([createdAt])
  @@map("opportunities")
}

model Event {
  id            String   @id @default(cuid())
  title         String
  eventType     String
  summary       String
  occurredAt    DateTime?
  evidenceRefs  Json
  missingData   Json
  riskNotes     Json
  labels        Json?
  canonicalEventId String?
  contextVersion   Int      @default(1)
  identity          Json?
  sourceSummary     Json?
  confidence    String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventType, status])
  @@index([occurredAt])
  @@index([canonicalEventId])
  @@map("events")
}

model PredxNewsItem {
  id                           String   @id @default(cuid())
  externalId                   String   @unique
  eventId                      String?
  factId                       String?
  title                        String
  newsTitle                    String?
  sourceName                   String?
  sourceUrl                    String?
  category                     String?
  publishedAt                  DateTime
  latestAt                     DateTime?
  primaryMarketTitle           String?
  primaryMarketUrl             String?
  primaryMarketConfidence      Float?
  associatedMarketDisplayScore Float?
  relatedMarkets               Json
  raw                          Json
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  recommendations OperationRecommendation[]

  @@index([publishedAt])
  @@index([category])
  @@map("predx_news_items")
}

model OperationContextInboxItem {
  id          String   @id @default(cuid())
  title       String
  source      String
  sourceUrl   String?
  rawContent  String
  summary     String?
  quality     String
  status      String
  conclusion  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("operation_context_inbox_items")
}

model OperationRecommendation {
  id                         String   @id @default(cuid())
  sourceEventId              String?
  predxNewsItemId            String?
  title                      String
  summary                    String
  recommendationLabels       Json
  basis                      String
  priority                   String
  reason                     String
  productAssociationStatus   String
  productAssociationLevel    String
  productAssociationRationale String
  selectedProductValue       String?
  recommendedProductPage     String?
  recommendedProductUrl      String?
  urlReason                  String?
  evidenceRefs               Json
  riskNotes                  Json
  missingData                Json
  status                     String
  confidence                 String
  agentRunId                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  predxNewsItem PredxNewsItem? @relation(fields: [predxNewsItemId], references: [id], onDelete: SetNull)
  angles        OperationRecommendationAngle[]

  @@index([status, createdAt])
  @@index([sourceEventId])
  @@index([predxNewsItemId])
  @@map("operation_recommendations")
}

model OperationRecommendationAngle {
  id               String   @id @default(cuid())
  recommendationId String
  level            String
  claim            String
  targetUser       String?
  userValue        String?
  evidence         Json
  productUrl       String?
  riskNotes        Json
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  recommendation OperationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId, sortOrder])
  @@map("operation_recommendation_angles")
}

model EventSourceContext {
  id              String   @id @default(cuid())
  mainEventId     String?
  sourceEventId   String?
  sourceType      String
  triggerType     String
  triggerRuleCode String?
  ruleVersion     String?
  contextVersion  Int      @default(1)
  title           String
  summary         String
  identity        Json
  evidenceRefs    Json
  signalRefs      Json
  payload         Json
  triggeredAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([mainEventId, sourceType])
  @@index([sourceType, triggeredAt])
  @@map("event_source_contexts")
}

model EventMergeDecision {
  id                   String   @id @default(cuid())
  incomingContextId     String
  candidateMainEventId  String?
  decision             String
  mergeConfidence      Float
  hardConflict         Boolean  @default(false)
  dimensionResults     Json
  conflictPoints       Json
  evidenceRefs         Json
  impact               Json
  agentRunId           String?
  decidedBy            String
  decidedAt            DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([incomingContextId])
  @@index([candidateMainEventId, decidedAt])
  @@map("event_merge_decisions")
}

model EventRelation {
  id           String   @id @default(cuid())
  fromEventId  String
  toEventId    String
  relationType String
  reason       String
  evidenceRefs Json
  createdBy    String
  createdAt    DateTime @default(now())

  @@unique([fromEventId, toEventId, relationType])
  @@index([fromEventId])
  @@index([toEventId])
  @@map("event_relations")
}

model AssignmentRun {
  id          String    @id @default(cuid())
  targetType  String
  targetId    String
  status      String
  goal        Json
  decision    Json?
  confidence  String?
  riskNotes   Json?
  missingData Json?
  startedAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items AssignmentItem[]

  @@index([targetType, targetId])
  @@map("assignment_runs")
}

model AssignmentItem {
  id            String   @id @default(cuid())
  runId         String
  targetType    String
  targetId      String
  accountId     String
  accountSource String
  sourceSystem  String?
  priority      String
  contentType   String
  contentGoal   String
  angle         String
  constraints   Json
  reason        String
  evidenceRefs  Json
  duplicateRisk String
  status        String
  createdTaskId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  run AssignmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([accountId, status])
  @@map("assignment_items")
}

model ContentTask {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  accountId   String
  contentType String
  contentGoal String
  angle       String
  constraints Json
  evidenceRefs Json
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([accountId, status])
  @@map("content_tasks")
}

model ContentDraft {
  id                   String   @id @default(cuid())
  contentTaskId         String
  version              Int
  body                 String
  evidenceRefs          Json
  generationInput       Json
  userInstruction       String?
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([contentTaskId, version])
  @@index([contentTaskId, status])
  @@map("content_drafts")
}

model PublishedPost {
  id            String    @id @default(cuid())
  contentTaskId String
  accountId     String?
  accountName   String?
  platform      String
  url           String
  publishedAt   DateTime
  firstTrackedAt DateTime?
  lastTrackedAt  DateTime?
  trackingStatus String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  metricSnapshots PostMetricSnapshot[]

  @@index([contentTaskId])
  @@index([accountId])
  @@index([trackingStatus, publishedAt])
  @@map("published_posts")
}

model PostMetricSnapshot {
  id              String   @id @default(cuid())
  publishedPostId  String
  observedAt       DateTime
  likes            Int?
  replies          Int?
  reposts          Int?
  quotes           Int?
  views            Int?
  rawMetrics       Json?
  isMissingData    Boolean  @default(false)
  errorMessage     String?
  createdAt        DateTime @default(now())

  publishedPost PublishedPost @relation(fields: [publishedPostId], references: [id], onDelete: Cascade)

  @@index([publishedPostId, observedAt])
  @@map("post_metric_snapshots")
}
