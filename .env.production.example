NODE_ENV=production
HOST=0.0.0.0
PORT=3001
HOST_PORT=3002

DATABASE_URL=postgresql://hotspot_agent:replace-password@replace-db-host:5432/hotspot_agent?schema=public

# 大模型
WORKFLOW_MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-production-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# X / Twitter 数据采集
TWITTERAPI_IO_KEY=replace-with-twitterapi-key
TWITTERAPI_BASE_URL=https://api.twitterapi.io
X_TRENDS_REGIONS=global,United States,United Kingdom,Japan,Korea
X_TRENDS_LIMIT=30
X_TRENDS_COLLECTION_INTERVAL_MS=10800000

# 调度
DATA_SOURCE_SCHEDULER_ENABLED=true
OPPORTUNITY_MINING_SCHEDULER_ENABLED=true
FUTURE_EVENT_SOURCE_SCHEDULER_ENABLED=true
FUTURE_EVENT_SOURCE_COLLECTION_INTERVAL_MS=86400000
FUTURE_EVENT_MONITORING_SCHEDULER_ENABLED=true
FUTURE_EVENT_MONITORING_INTERVAL_MS=3600000

# YouTube
YOUTUBE_API_KEY=replace-with-youtube-api-key
YOUTUBE_COLLECTION_INTERVAL_MS=86400000
YOUTUBE_ANALYSIS_CONCURRENCY=1
YOUTUBE_ANALYSIS_MODEL_TIMEOUT_MS=45000
YOUTUBE_ANALYSIS_MODEL=gpt-4o-mini
YOUTUBE_YTDLP_IMPERSONATE=chrome
# 容器里无法直接读取宿主机浏览器 Cookie，如需提升字幕成功率，把 cookies 文件放到服务器 job 目录 private/youtube-cookies.txt。
# YOUTUBE_COOKIES_PATH=/app/private/youtube-cookies.txt
